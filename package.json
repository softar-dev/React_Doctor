{
  "name": "react-doctor",
  "version": "1.0.0",
  "description": "React Performance Analyzer CLI & Backend",
  "main": "cli/dist/index.js",
  "bin": {
    "react-doctor": "./cli/dist/index.js"
  },
  "scripts": {
    "postinstall": "npm run install:submodules",
    "install:submodules": "cd cli && npm install --ignore-scripts && cd ../backend && npm install --ignore-scripts",
    "build:cli": "cd cli && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:cli && npm run build:backend"
  },
  "keywords": ["react", "performance", "cli", "analyzer"],
  "author": "Ozma",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "ora": "^5.4.1",
    "puppeteer-core": "^22.0.0",
    "web-vitals": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/fs-extra": "^11.0.4"
  },
  "files": [
    "cli/dist/**",
    "cli/package.json",
    "core/**",
    "backend/dist/**",
    "backend/package.json",
    "package.json"
  ]
}